                        <ui:VisualElement name="SoundEffectToggleIcon" style="background-image: url(&quot;project://database/Assets/Sprites/Icons/Volume_On.png?fileID=21300000&amp;guid=3fd2cfd63d8c78b448686ed0f062e43c&amp;type=3#Volume_On&quot;); flex-grow: 1; -unity-background-image-tint-color: rgb(79, 130, 255);" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="PlayGoalCompletePopup" class="uofr-container " style="display: none;">
                <ui:Label text="You were distracted for 15 minutes!" class="uofr-title-medium" />
                <ui:VisualElement class="uofr-space-medium" />
                <ui:VisualElement class="uofr-container" style="background-image: url(&quot;project://database/Assets/Sprites/PlayGoalComplete_Art.jpg?fileID=21300000&amp;guid=5ed1fa0832702b443ab05cbb02370187&amp;type=3#PlayGoalComplete_Art&quot;); -unity-background-scale-mode: scale-and-crop; width: 60%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 60%; padding-bottom: 0; align-self: center;" />
                <ui:VisualElement class="uofr-space-medium" />
                <ui:Label text="Well done! Being distracted for stretches of time like this can help lower your cravings." class="uofr-text-small" style="-unity-text-align: upper-center; color: rgb(97, 97, 97);" />
                <ui:VisualElement class="uofr-space-small" />
                <ui:Label text="Start again to see how many points you can earn, or go enjoy some healthy breathing!" class="uofr-text-small" style="-unity-text-align: upper-center; color: rgb(97, 97, 97);" />
                <ui:VisualElement class="uofr-space-medium" />
                <ui:Label text="Final Score" class="uofr-text-small" style="-unity-text-align: upper-center; color: rgb(97, 97, 97);" />
                <ui:Label text="1021 pts" name="FinalScoreLabel" class="uofr-title-medium" />
                <ui:VisualElement class="uofr-space-medium" />
                <ui:Button text="Restart" name="RestartSessionButton" class="uofr-button uofr-button-highlight " />
                <ui:VisualElement class="uofr-space-small" />
                <ui:Button text="Finish" name="FinishSessionButton" class="uofr-button " />
            </ui:VisualElement>
            <ui:Instance template="PlayGoalInfoScreen" name="PlayGoalInfoPopup" style="display: none;" />
