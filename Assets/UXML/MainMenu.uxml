                    <ui:VisualElement class="uofr-space-small" />
                    <ui:Label text="About" class="uofr-text-medium" style="flex-grow: 1; -unity-text-align: middle-left;" />
                </ui:Button>
                <ui:VisualElement class="uofr-hr" />
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement class="" style="background-image: url(&quot;project://database/Assets/Sprites/Icons/Music.png?fileID=21300000&amp;guid=3017e2d1ddd42f54cb17f79eded2e408&amp;type=3#Music&quot;); width: 60px; height: 60px; -unity-background-image-tint-color: rgb(0, 0, 0);" />
                    <ui:VisualElement class="uofr-space-small" />
                    <ui:Label text="Music" class="uofr-text-medium" style="-unity-font-style: bold;" />
                    <ui:VisualElement class="uofr-space-small" />
                    <ui:Button name="MusicToggleButton" class="uofr-button uofr-button-square">
                        <ui:VisualElement name="MusicToggleIcon" style="background-image: url(&quot;project://database/Assets/Sprites/Icons/Volume_On.png?fileID=21300000&amp;guid=3fd2cfd63d8c78b448686ed0f062e43c&amp;type=3#Volume_On&quot;); flex-grow: 1; -unity-background-image-tint-color: rgb(79, 130, 255);" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="uofr-space-small" />
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement class="" style="background-image: url(&quot;project://database/Assets/Sprites/Icons/Music.png?fileID=21300000&amp;guid=3017e2d1ddd42f54cb17f79eded2e408&amp;type=3#Music&quot;); width: 60px; height: 60px; -unity-background-image-tint-color: rgb(0, 0, 0);" />
                    <ui:VisualElement class="uofr-space-small" />
